# Copy to .env and fill in. Never commit the real .env.

# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: only needed if you configure a webhook in the PayPal dashboard
PAYPAL_WEBHOOK_ID=
# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# --- Server ---
PORT=3000
# Public URL of this backend. PayPal redirects the buyer back here after approval.
# Locally: http://localhost:3000   On Render: https://your-service.onrender.com
PUBLIC_BASE_URL=http://localhost:3000
# Per-session spending cap in USD; the agent cannot propose a cart above it.
DEFAULT_SPENDING_LIMIT=50
